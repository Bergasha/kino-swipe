<Container version="2">
  <Name>Kino Swipe</Name>
  <Repository>bergasha/kino-swipe:latest</Repository>
  <Registry>https://hub.docker.com/repository/docker/bergasha/kino-swipe</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  
  <WebUI>http://[IP]:[PORT:5005]</WebUI>

  <Overview>Swipe and match movies for Plex and Jellyfin. Basic dating app rules: swipe left if it is a no and swipe right if it is a yes. Two right swipes and it's a match. All matches are stored in your match history for later viewing.</Overview>

  <Support>https://github.com/Bergasha/kino-swipe/issues</Support>
  
  <Project>https://github.com/Bergasha/kino-swipe</Project>

  <ReadMe>https://raw.githubusercontent.com/Bergasha/kino-swipe/main/README.md</ReadMe>

  <Discord/>
  
  <Category>MediaApp:Video MediaApp:Other</Category>
  
  <Beta>false</Beta>

  <MinVer>6.9.0</MinVer>
  <MaxVer/>

  <Deprecated>false</Deprecated>

  <DeprecatedMaxVer/>

  <License>MIT</License>

  <Screenshot/>
  
  <Video/>

  <Icon>https://github.com/Bergasha/kino-swipe/blob/main/static/main.png?raw=true</Icon>
  <Description>Swipe and match movies for Plex and Jellyfin</Description>

  <Config Name="WebUI Port" Target="5005" Default="5005" Mode="tcp" Description="Port used to access Kino Swipe" Type="Port" Display="always" Required="true" Mask="false">5005</Config>
  <Config Name="PLEX_URL" Target="PLEX_URL" Default="" Description="URL of your Plex server (Optional)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="PLEX_TOKEN" Target="PLEX_TOKEN" Default="" Description="Your Plex token (Optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="JELLYFIN_URL" Target="JELLYFIN_URL" Default="" Description="URL of your Jellyfin server (Optional)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="JELLYFIN_API_KEY" Target="JELLYFIN_API_KEY" Default="" Description="Your Jellyfin API Key (Optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="TMDB_API_KEY" Target="TMDB_API_KEY" Default="" Description="TMDB API key for trailers and metadata to work" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="FLASK_SECRET" Target="FLASK_SECRET" Default="" Description="Random secret string for session security" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="AppData Config Path" Target="/app/data" Default="/mnt/user/appdata/kino-swipe/data" Mode="rw" Description="Persistent storage for Kino Swipe data" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/kino-swipe/data</Config>
  <Config Name="Static Content Path" Target="/app/static" Default="/mnt/user/appdata/kino-swipe/static" Mode="rw" Description="Persistent storage for local static files" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/kino-swipe/static</Config>
</Container>
